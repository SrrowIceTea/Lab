# ── 本地 Agent 使用的外部大模型（OpenAI Chat Completions 兼容）────────
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=120
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
LLM_GUIDANCE_MODEL=
ENABLE_FAKE_LLM_FOR_TEST=false

# RAG（本地 MySQL 知识库 + 标准题库，供应商无关）
RAG_MODE=local
ENABLE_LOCAL_RAG=true
STRICT_SOURCE_EXAMPLE_VALIDATION=false

# ── 文档 RAG：Embedding（硅基流动 SiliconFlow，OpenAI 兼容）────────
# 填写你的硅基流动 API Key（https://cloud.siliconflow.cn 控制台获取）
EMBEDDING_API_KEY=your_siliconflow_api_key_here
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT=60
ENABLE_DOCUMENT_RAG=true
DOC_CHUNK_SIZE=500
DOC_CHUNK_OVERLAP=80
DOC_TOP_K=3

# AI agent service listener
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8010
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MySQL persistence
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=seclab_app
MYSQL_PASSWORD=Seclab@123
MYSQL_DATABASE=seclab_profile
MYSQL_CHARSET=utf8mb4
