# 后端用户服务地址
VITE_API_BASE_URL=http://localhost:8083

# 图片服务地址，用于注册头像上传
VITE_IMAGE_SERVICE_BASE_URL=http://localhost:8086/api/images

# Docker API 服务地址
VITE_DOCKER_API_URL=http://localhost:3000

# FastAPI Agent 服务地址
VITE_AGENT_BASE_URL=http://localhost:8010

# noVNC 操作环境桌面地址
VITE_NOVNC_URL=http://127.0.0.1:8443

# 阿里云 OSS 教学视频地址（公共读 bucket，前端直接拼接 URL 播放）
# bucket: labsyssss，区域：华北2（北京）
VITE_OSS_BASE_URL=https://labsyssss.oss-cn-beijing.aliyuncs.com
# 视频在 bucket 内的目录；若视频直接上传在根目录，请留空（VITE_OSS_VIDEO_DIR=）
VITE_OSS_VIDEO_DIR=video
